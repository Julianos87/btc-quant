#!/usr/bin/env bash
# Filet de sécurité local : lance le lint et les tests avant chaque push.
# Un push est refusé si l'un des deux échoue.
#
# Activation (déjà faite, à rejouer après un nouveau clone) :
#   git config core.hooksPath .githooks
#
# Contournement ponctuel, à n'utiliser qu'en connaissance de cause :
#   git push --no-verify
#
# Ce hook double la CI GitHub Actions (.github/workflows/tests.yml), qui teste
# en plus Python 3.11 ET 3.12 ; ici on ne teste que l'interpréteur local.

set -uo pipefail

# Le hook s'exécute depuis la racine du dépôt.
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push : uv introuvable dans le PATH — vérification ignorée." >&2
  echo "           installer uv, ou pousser avec --no-verify." >&2
  exit 0
fi

# Dossier temporaire local : sous Windows, le dossier temp système est parfois
# inaccessible à pytest (PermissionError), ce qui ferait échouer le hook à tort.
TMPDIR_LOCAL=".pytest-tmp"

echo "pre-push : lint (ruff)…"
if ! uv run ruff check . ; then
  echo >&2
  echo "✗ pre-push : le lint a échoué — push annulé." >&2
  echo "  corriger, ou : uv run ruff check . --fix" >&2
  exit 1
fi

echo "pre-push : tests sur l'interpréteur local…"
if ! uv run pytest -q --basetemp="${TMPDIR_LOCAL}" ; then
  echo >&2
  echo "✗ pre-push : des tests échouent — push annulé." >&2
  exit 1
fi

# Le VPS tourne Python 3.12, le poste de dev 3.11 : sans ce second passage, rien
# ne vérifierait le code sur la version réellement en production. uv télécharge
# et met en cache l'interpréteur au premier appel.
echo "pre-push : tests sur Python 3.12 (version du VPS)…"
if ! uv run --python 3.12 --isolated \
        --with-requirements requirements.txt --with pytest --with-editable . \
        pytest -q --basetemp="${TMPDIR_LOCAL}" ; then
  echo >&2
  echo "✗ pre-push : des tests échouent sous Python 3.12 — push annulé." >&2
  echo "  cette version est celle du VPS : ne pas ignorer." >&2
  exit 1
fi

echo "✓ pre-push : lint et tests OK (local + Python 3.12)."
exit 0
