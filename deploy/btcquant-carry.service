[Unit]
Description=btcquant - moteur carry 3x (paper trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btcquant
WorkingDirectory=/opt/btcquant
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/opt/btcquant/.env
ExecStart=/opt/btcquant/venv/bin/python scripts/run_carry.py --capital 4000 --leverage 3
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
