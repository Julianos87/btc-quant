[Unit]
Description=btcquant - sauvegarde quotidienne de state/

[Service]
Type=oneshot
User=btcquant
WorkingDirectory=/opt/btcquant/current
EnvironmentFile=-/opt/btcquant/.env
Environment=BTCQUANT_ROOT=/opt/btcquant
ExecStart=/usr/bin/env bash /opt/btcquant/current/scripts/backup_state.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# La clé SSH hors-site réside dans ~btcquant/.ssh : lecture autorisée, écriture refusée.
ProtectHome=read-only
ReadWritePaths=/opt/btcquant/state /opt/btcquant/backups -/opt/btcquant/backups-repo
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
