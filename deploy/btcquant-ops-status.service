[Unit]
Description=btcquant - statut opérationnel PAPER en lecture seule
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=BTCQUANT_ROOT=/opt/btcquant
ExecStart=/opt/btcquant/current/venv/bin/python -m btcquant.entrypoints.ops_status --json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# SQLite read-only WAL probes need to create/remove the shared-memory sidecar.
# Keep the database and WAL read-only; the connection also uses mode=ro/query_only.
ReadWritePaths=/opt/btcquant/state
ReadOnlyPaths=/opt/btcquant/state/btcquant.db
ReadOnlyPaths=-/opt/btcquant/state/btcquant.db-wal
ReadOnlyPaths=-/opt/btcquant/state/btcquant.db-journal
ProtectHome=read-only
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
