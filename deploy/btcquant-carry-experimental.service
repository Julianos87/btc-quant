[Unit]
Description=btcquant - Carry PAPER expérimental isolé
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=BTCQUANT_ROOT=/opt/btcquant/carry-experiment
ExecStart=/opt/btcquant/current/venv/bin/btcquant-carry --config /opt/btcquant/current/environments/paper/carry_cash.yaml
Restart=always
RestartSec=30
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/carry-experiment/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=768M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
