[Unit]
Description=btcquant - collecte publique Carry BTC à échéance PAPER
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=btcquant
Group=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=BTCQUANT_LOG_LEVEL=INFO
Environment=BTCQUANT_ROOT=/opt/btcquant
ExecStart=/opt/btcquant/current/venv/bin/python -m btcquant.research.carry_dated_collector --database /opt/btcquant/state/carry-dated-experiment/market.sqlite3 --archive-dir /opt/btcquant/data/carry-dated-experiment/archive --status-path /opt/btcquant/state/carry-dated-experiment/collector_status.json --interval 30 --book-depth 20 --settlement-interval 1800 --archive-age-hours 24 --retention-days 700 --max-total-bytes 5368709120 --min-free-bytes 10737418240 --books-from-runner
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state/carry-dated-experiment /opt/btcquant/data/carry-dated-experiment
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
CPUQuota=20%
TasksMax=16

[Install]
WantedBy=multi-user.target
