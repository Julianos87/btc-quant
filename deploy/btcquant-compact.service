[Unit]
Description=btcquant - compaction de l'historique SQLite (equity + journal)

[Service]
Type=oneshot
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=BTCQUANT_ROOT=/opt/btcquant
EnvironmentFile=-/opt/btcquant/.env
ExecStart=/opt/btcquant/current/venv/bin/python /opt/btcquant/current/scripts/compact_equity.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
