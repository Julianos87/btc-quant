[Unit]
Description=btcquant - start bound PAPER maturity campaign
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=BTCQUANT_ROOT=/opt/btcquant
EnvironmentFile=-/opt/btcquant/.env
ExecStart=/opt/btcquant/current/venv/bin/btcquant-readiness start --profile paper
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
