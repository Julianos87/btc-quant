[Unit]
Description=btcquant - bilan hebdomadaire Telegram

[Service]
Type=oneshot
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=-/opt/btcquant/.env
ExecStart=/opt/btcquant/current/venv/bin/btcquant-digest --weekly
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
