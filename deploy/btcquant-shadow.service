[Unit]
Description=btcquant - observation shadow mainnet (aucun ordre)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=BTCQUANT_ROOT=/opt/btcquant
ExecStart=/opt/btcquant/current/venv/bin/btcquant-shadow --database /opt/btcquant/state/execution-shadow.db run
Restart=always
RestartSec=15
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
