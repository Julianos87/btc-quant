[Unit]
Description=btcquant - dashboard web
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=btcquant
WorkingDirectory=/opt/btcquant/current
Environment=PYTHONIOENCODING=utf-8
Environment=HOME=/opt/btcquant/state
EnvironmentFile=/opt/btcquant/.env
ExecStart=/opt/btcquant/current/venv/bin/gunicorn dashboard.wsgi:app --bind 127.0.0.1:8666 --workers 1 --threads 4 --timeout 30 --graceful-timeout 30 --access-logfile - --error-logfile -
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btcquant/state
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
